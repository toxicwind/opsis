{
  "name": "estate-mesh-browserless",
  "version": "0.1.0",
  "description": "Browserless — Estate Mesh: Headed browser automation for the fleet",
  "main": "viewer/index.ts",
  "type": "module",
  "bin": {
    "estate-mesh": "viewer/index.ts"
  },
  "scripts": {
    "dev": "bun --hot run viewer/index.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "build": "bun build viewer/index.ts --target bun --outdir ./dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5.6.3",
    "@biomejs/biome": "^1.9.4"
  },
  "private": true
}
